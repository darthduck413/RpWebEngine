# RWE ships with no credentials. Every key below is optional — the app works
# without this file, and keys entered in the UI (API Settings) are stored in the
# browser's localStorage instead. These variables only pre-fill a self-hosted
# deployment so you don't have to paste keys into every browser you use.
#
# Copy to .env.local and fill in whichever you need.

# ---------------------------------------------------------------------------
# Client (bundled into the build — anyone who can open the page can read them,
# so only use keys you are comfortable exposing to that audience)
# ---------------------------------------------------------------------------

# Default key for the Proxy provider (any OpenAI-compatible /chat/completions
# endpoint: OpenRouter, a self-hosted LM Studio / llama.cpp server, etc.)
VITE_PROXY_API_KEY=

# Google AI Studio key for the Gemini provider.
VITE_GEMINI_API_KEY=

# Optional second Gemini key that is billed, which is what lets presets request
# Google's cheaper Flex service tier.
VITE_GEMINI_PAID_API_KEY=

# ---------------------------------------------------------------------------
# Server (used by api/proxy/chat.ts, never sent to the browser)
# ---------------------------------------------------------------------------

# Extra hostnames the CORS proxy may forward to, comma-separated. The built-in
# allowlist already covers the major gateways; add your own inference server or
# tunnel here. Leaving this empty keeps the proxy from becoming an open relay.
# Example: PROXY_ALLOWED_HOSTS=my-box.example.com,my-tunnel.ngrok-free.dev
PROXY_ALLOWED_HOSTS=
